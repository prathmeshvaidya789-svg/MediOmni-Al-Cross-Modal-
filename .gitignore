# ===========================
# Dependencies
# ===========================
node_modules/
.pnp
.pnp.js

# ===========================
# Testing
# ===========================
coverage/

# ===========================
# Production Build Output
# ===========================
frontend/dist/
frontend/build/
build/

# ===========================
# Environment Variables
# NEVER commit real .env files
# ===========================
.env
.env.local
.env.production
.env.development
# Allow example/template files
!.env.example
!.env.production.example
!backend/.env.example
!frontend/.env.production.example

# ===========================
# Logs
# ===========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ===========================
# Uploaded media (keep empty dir in git)
# ===========================
backend/uploads/*
!backend/uploads/.gitkeep

# ===========================
# IDE and Editor
# ===========================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
