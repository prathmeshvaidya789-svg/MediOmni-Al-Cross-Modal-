# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Use local MongoDB (mongodb://localhost:27017/multimodal_ai) or MongoDB Atlas URI
MONGODB_URI=mongodb://localhost:27017/multimodal_ai

# JWT Secret & Expiry
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Google Gemini API Key (KEEP THIS STRICTLY SECURE ON BACKEND)
# Obtain your key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection
GEMINI_MODEL=gemini-1.5-flash

# Frontend Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# File Upload Settings
MAX_FILE_SIZE_MB=25
MAX_FILES_COUNT=10
